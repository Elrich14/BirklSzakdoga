# --- Backend API base URL (required) -----------------------------------------
# The Next.js client uses this for every API call. For local dev with the
# default docker-compose / backend setup, leave it as http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Stripe publishable key (required only for the payment flow) -------------
# Test mode publishable key from https://dashboard.stripe.com/test/apikeys
# Safe to expose — Stripe publishable keys are designed to be client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
