{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --hard *)",
      "Bash(git rebase)",
      "Bash(git rebase:*)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick:*)",
      "Bash(git cherry-pick *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git stash drop:*)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git stash pop:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -D *)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge *)"
    ]
  }
}
